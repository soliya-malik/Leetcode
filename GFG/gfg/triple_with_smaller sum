class Solution {

  public:
    long long countTriplets(int n, long long sum, long long arr[]) {
        // Your code goes here
        long long ans=0;
        int i = 0;
       
        
       sort(arr,arr+n); // array is the pointer here arr is a C-style array, not a vector.
        
        for(int i = 0 ;i < n-2;i++){
             int left = i+1; // so left/right must reset every iteration.
             int right=n-1;
             while(left < right){
            long long res =arr[i] + arr[left] + arr[right];
            
            if(res >= sum){
                right--;
            }
            else{
                ans = ans + (right-left);
                left++;
            }
             }
        }
        return ans;
    }
};